{
  "name": "remove-meeting-bots",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "description": "Find AI notetaker bots in a Google Meet call and remove them all in one click.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build:dev": "wxt build -m development",
    "play": "vite --host 127.0.0.1 --port 5174 --open /test/fake-meet-manual.html",
    "play:clone": "pnpm --dir meet-clone dev",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "wxt prepare",
    "postinstall": "wxt prepare",
    "test": "pnpm test:names && pnpm test:labels && pnpm test:dom && pnpm test:dom:bare && pnpm test:dom:many && pnpm test:dom:guest",
    "test:names": "node test/classify.test.js",
    "test:labels": "node test/meet-labels.test.js",
    "test:dom": "node test/run-dom.mjs",
    "test:dom:bare": "node test/run-dom.mjs --page=fake-meet-bare.html",
    "test:dom:show": "node test/run-dom.mjs --show",
    "test:dom:many": "node test/run-dom.mjs --page=fake-meet-many.html",
    "test:dom:guest": "node test/run-dom.mjs --page=fake-meet-guest.html",
    "test:dom:guest:show": "node test/run-dom.mjs --page=fake-meet-guest.html --show",
    "test:dom:many:show": "node test/run-dom.mjs --page=fake-meet-many.html --show"
  },
  "devDependencies": {
    "@wxt-dev/module-react": "^1.2.2",
    "vite": "^8.2.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
